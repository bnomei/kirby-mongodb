{
    "name": "bnomei/kirby-mongodb",
    "type": "kirby-plugin",
    "version": "6.0.0",
    "description": "Khulan is a cache driver and content cache with NoSQL interface for Kirby using MongoDB",
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Meilick",
            "email": "b@bnomei.com"
        }
    ],
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "pages",
        "files",
        "users",
        "content",
        "cache",
        "performance",
        "nosql",
        "mongodb"
    ],
    "conflict": {
        "bnomei/kirby3-boost": "*",
        "getkirby/cms": "<6.0 || >=7.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Bnomei\\": "classes/"
        }
    },
    "require": {
        "php": ">=8.3",
        "getkirby/composer-installer": "^1.2",
        "mongodb/mongodb": "^1.21.5",
        "ext-mongodb": "*"
    },
    "require-dev": {
        "getkirby/cli": "^2.1",
        "getkirby/cms": "^6.0",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^v3.5.1",
        "phpstan/phpstan": "^2.0",
        "spatie/ray": "^1.39"
    },
    "scripts": {
        "stan": "./vendor/bin/phpstan",
        "fix": "./vendor/bin/pint",
        "test": "./vendor/bin/pest --profile",
        "dist": [
            "composer fix",
            "composer install --no-dev --optimize-autoloader",
            "git rm -rf --cached .; git add .;"
        ],
        "kirby": [
            "composer install"
        ]
    },
    "extra": {
        "kirby": {
            "compatible": "^6.0"
        },
        "kirby-cms-path": "tests/kirby"
    },
    "suggest": {
        "bnomei/kirby-blueprints": "PHP Class-based Blueprints for Kirby CMS for better type safety and code completion.",
        "bnomei/kirby3-lapse": "Cache any data until set expiration time (with automatic keys).",
        "getkirby/staticache": "Static site performance on demand!"
    }
}
